{
  "name": "smchs-app",
  "version": "1.0.0",
  "private": true,
  "description": "Santa Margarita Catholic High School app — one fast, offline-first student/parent app (web + PWA + iOS/Android via Capacitor).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "serve": "npx --yes serve@latest out",
    "cap:sync": "npm run build && npx cap sync",
    "mcp": "node server/mcp.mjs",
    "mcp:http": "node server/mcp.mjs --http 8181",
    "mcp:seeds": "node server/build-seeds.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/ios": "^6.2.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@react-three/drei": "^9.114.6",
    "@react-three/fiber": "^8.17.10",
    "leaflet": "^1.9.4",
    "luxon": "^3.5.0",
    "next": "14.2.18",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zod": "^3.25.76",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@types/leaflet": "^1.9.21",
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.16.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  }
}
