# SMCHS app server configuration. Copy to .env and fill in.

# Port the app + API serve on. Put your TLS reverse proxy in front of it.
PORT=8080

# Optional. Defaults to 127.0.0.1 so this plain-HTTP port is reachable only by
# a reverse proxy on the same machine - staff tokens travel over it, so it must
# not be exposed directly. Set 0.0.0.0 only for LAN/VPN testing, or when the
# proxy runs on a different host.
#HOST=0.0.0.0

# BellCalSync calendar API key (primary schedule source). Without it the
# server falls back to the public CalendarWiz feed.
CALENDAR_API_KEY=

# REQUIRED IN PRODUCTION. The app's public address, used to build the staff
# password-setup links that get emailed. Without it those emails contain a
# link with no domain, which is broken for the recipient. This is deliberately
# NOT taken from the incoming request: doing that let anyone request a link for
# any staff member and have the school's own mail server send that real token
# to a look-alike domain they controlled.
APP_ORIGIN=https://app.your-domain.org

# REQUIRED IN PRODUCTION. Staff password-setup links are emailed through this.
# If unset, the server refuses to hand the link back over HTTP, so account
# setup simply cannot complete until email works.
#
# Authenticated relay (Office 365, Google Workspace, most internet SMTP):
# set SMTP_USER and SMTP_PASS (always together). Port picks the wire mode:
# 587 (or anything except 465) = STARTTLS, 465 = implicit TLS. Credentials
# are only ever sent over the encrypted channel in either mode.
#
# Anonymous internal relay (e.g. a district send-only relay on port 25):
# leave SMTP_USER and SMTP_PASS BOTH empty and set SMTP_FROM. No AUTH is
# sent, and on any port except 465 the connection is plain SMTP — the
# emails carry live password-setup links, so point this only at a relay
# on your own network.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SMCHS App <no-reply@smhs.org>"

# Optional: contact address push services can reach about this sender
# (schedule-change notifications). Defaults to mailto:app@smhs.org.
#VAPID_SUBJECT=mailto:app@smhs.org

# Optional: lock CORS to one origin (e.g. https://app.smhs.org). Leave unset
# to allow any origin; the app itself is same-origin either way. Note the
# native iOS/Android shells send capacitor://localhost origins - test before
# setting this if those shells are in use.
#ALLOWED_ORIGIN=

# Leave BOTH unset in production. They enable passwordless test accounts, and
# ALLOW_TEST_ACCOUNTS additionally lets the server return a password-setup link
# in the HTTP response when email is unavailable - convenient for local testing,
# account takeover if it were ever on in production.
#ALLOW_TEST_ACCOUNTS=
#NEXT_PUBLIC_TEST_ACCOUNTS=

# Optional: restrict who may write shared app data. Unset (recommended) means
# staff in the Admin portal's departments - Dean's Office, Educational
# Technology, President's Office, Principal's Office - which tracks the staff
# directory automatically. Set it only to override that.
#ADMIN_EMAILS=

# Set only when a reverse proxy in front of this server rewrites
# X-Forwarded-For. Without it the header is ignored, because a caller can
# otherwise forge a new rate-limit bucket per request.
#TRUST_PROXY=

# MCP server (started by start-prod.sh alongside the app; see docs/MCP.md).
# Serves the read-only public tool set on 127.0.0.1:8181 by default — route
# /mcp and /.well-known/oauth-* through the reverse proxy to expose it.
# 0 disables it entirely.
#MCP_PORT=8181
# 1 (default) = public read-only tools. 0 = full staff/admin tool set;
# never expose a full-mode instance beyond localhost or a trusted proxy.
#SMCHS_PUBLIC=1
